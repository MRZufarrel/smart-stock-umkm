# Salin file ini menjadi server/.env lalu isi nilainya.
# JANGAN pernah mengisi nilai asli di file ini atau di-commit ke Git.

PORT=5000
NODE_ENV=development

# OPSI A: Gunakan DATABASE_URL jika hosting di cloud (Neon, Supabase, Render, Railway).
# Jika DATABASE_URL diisi, parameter DB_HOST dkk di bawah tidak wajib diisi.
# Contoh: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OPSI B: Parameter individual untuk database lokal / custom
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=smart_stock_db

# Gunakan string acak yang panjang — minimal 32 karakter.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Izinkan origin frontend. Gunakan URL prod di environment production.
# Contoh: https://app.florawins.com
CORS_ORIGIN=http://localhost:5173
